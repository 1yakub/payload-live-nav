{
  "name": "payload-live-nav",
  "version": "0.1.0",
  "description": "Section index and field to preview focus bridge for the Payload admin: click a section to jump both the form and the Live Preview, focus a field to flash it on the page.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1yakub/payload-live-nav.git"
  },
  "author": "Yakub Hossain",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "live-preview",
    "navigation",
    "admin",
    "cms"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "import": "./dist/frontend.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "payload": ">=3.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
